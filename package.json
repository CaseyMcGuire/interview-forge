{
  "name": "application",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "watch": "vite build --watch --mode development --outDir build/resources/main/static/bundles",
    "relay-compiler": "spa-kit-compile-relay --schema-dir src/main/resources/schema --out src/main/resources/relay/schema.graphql"
  },
  "relay": {
    "src": "src/main/web-frontend",
    "language": "typescript",
    "schema": "src/main/resources/relay/schema.graphql",
    "artifactDirectory": "./src/main/web-frontend/__generated__",
    "eagerEsModules": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaseyMcGuire/puzzlr-kotlin.git"
  },
  "author": "Casey McGuire",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/CaseyMcGuire/puzzlr-kotlin/issues"
  },
  "homepage": "https://github.com/CaseyMcGuire/puzzlr-kotlin#readme",
  "dependencies": {
    "@graphiql/toolkit": "^0.12.1",
    "@spa-kit/react": "^0.0.3",
    "@spa-kit/react-relay": "^0.0.1",
    "@spa-kit/react-router": "^0.0.3",
    "@stylexjs/stylex": "^0.19.0",
    "graphiql": "^5.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-relay": "^21.0.1",
    "react-router": "^8.3.1",
    "relay-runtime": "^21.0.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/plugin-transform-runtime": "^8.0.1",
    "@babel/runtime": "^8.0.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@spa-kit/node": "^0.0.2",
    "@stylexjs/unplugin": "^0.19.0",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-relay": "^18.2.1",
    "@types/relay-runtime": "^20.1.1",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "babel-plugin-relay": "^21.0.1",
    "graphql": "^16.14.2",
    "js-beautify": "^2.0.3",
    "relay-compiler": "^21.0.1",
    "rolldown": "~1.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-checker": "^0.14.5"
  },
  "type": "module"
}
